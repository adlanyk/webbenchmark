# ================================
# ENVIRONMENT & OS
# ================================
.env
.env.backup
.env.production
.DS_Store
Thumbs.db
*.log

# ================================
# LARAVEL (DI DALAM FOLDER APPLICATION)
# ================================
application/.phpunit.cache
application/node_modules
application/public/build
application/public/hot
application/public/storage
application/storage/*.key
application/vendor
application/.env
application/.phpunit.result.cache
application/Homestead.json
application/Homestead.yaml
application/auth.json
application/npm-debug.log
application/yarn-error.log
application/.fleet
application/.idea
application/.vscode

# ================================
# CUSTOM UPLOADS (AUDIT 5R)
# ================================
application/storage/app/public/audit-findings/*
application/storage/app/public/audit-fixes/*
!application/storage/app/public/audit-findings/.gitignore
!application/storage/app/public/audit-fixes/.gitignore

# ================================
# LOGS & CACHE
# ================================
application/storage/logs/*